# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#
pcb.csv

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

# === MicroPython Specific ===
# Compiled bytecode & board build files
*.mpy
/build/
/dist/

# MicroPython tools & IDE setup
.vscode/mpy-config.json
.rshellrc
.mpremote/

# Thonny IDE local settings
.thonny/
.thonny_settings.json

# Local environment & secrets (Wi-Fi credentials, API keys)
config.py
secrets.py
env.py

# === Python General & Virtual Environments ===
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env

# === Hardware / Toolchain (esp-idf, C-modules) ===
.sconf_temp/
.sconsign.dblite
